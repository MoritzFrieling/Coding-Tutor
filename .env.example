# Copy this file to .env and paste your Google AI Studio / Gemini API key after the equals sign.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HOST=127.0.0.1
PORT=4173
BASE_PATH=/

# Set this before exposing the Node server beyond your computer.
# The app asks for the token in Admin and keeps it in this tab only.
APP_ACCESS_TOKEN=
